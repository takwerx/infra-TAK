policy_module(takwerx_console_confined, 0.1.0)

########################################
# infra-TAK console — CONFINED domain (v10.0.5, SELinux hardening)
#
# Moves the non-root console OFF unconfined_service_t into a dedicated, confined
# `takwerx_console_t` domain. The console is a thin Flask/gunicorn app: it reads
# its install (/opt/infratak), reads/writes its config (.config), binds :5001,
# connects to the root broker's unix socket (/run/takwerx-broker.sock), spawns the
# brokerctl helper, and makes outbound HTTP. ALL genuinely-privileged work happens
# in the SEPARATE root broker process — so the console itself needs very little,
# which is exactly what makes confining it feasible (the whole point of the broker
# architecture).
#
# DEVELOPMENT POSTURE: this module ships `permissive takwerx_console_t` — the
# domain is ACTIVE (so AVCs are logged against it) but does NOT block, so it can
# never brick the console. The allow-rules below are grown from real AVCs
# (audit2allow) until the domain runs a full deploy with ZERO denials; only then
# is `permissive` removed and the domain enforced. Until then the box stays safe.
########################################

require {
    type init_t;
    type unconfined_service_t;
    type user_home_t;
    type user_home_dir_t;
    type tmp_t;
    type var_run_t;
    class process { transition dyntransition siginh rlimitinh noatsecure signal sigchld };
    class dir { search getattr open read };
    class file { open read getattr execute execute_no_trans map ioctl entrypoint };
    class lnk_file read;
    class sock_file { write };
    class unix_stream_socket connectto;
}

type takwerx_console_t;
domain_type(takwerx_console_t)
role system_r types takwerx_console_t;

# Permissive WHILE WE HARVEST. Remove this line to enforce (only after a full
# deploy shows zero AVCs against takwerx_console_t).
permissive takwerx_console_t;

# systemd (init_t) launches the console with SELinuxContext=...:takwerx_console_t,
# i.e. setexeccon -> transition. Allow the transition + the inherited bits.
allow init_t takwerx_console_t:process { transition dyntransition siginh rlimitinh noatsecure };
allow takwerx_console_t init_t:process sigchld;

# Enter the domain via the in-home / relocated venv entrypoint (covers both the
# /opt/infratak install and a legacy in-home clone).
allow takwerx_console_t user_home_t:file entrypoint;
allow init_t user_home_dir_t:dir search;
allow init_t user_home_t:file { open read getattr execute execute_no_trans map ioctl };
allow init_t user_home_t:lnk_file read;

# Connect to the root broker's unix socket (the console's ONLY privilege path).
allow takwerx_console_t var_run_t:sock_file write;
allow takwerx_console_t init_t:unix_stream_socket connectto;

# Everything else (file reads under /opt, config I/O, network bind/connect, exec
# of the brokerctl python helper, /proc reads, etc.) is added below from harvested
# AVCs — see the HARVESTED block, regenerated by audit2allow on the box.

########################################
# HARVESTED (audit2allow) — appended during development; empty on first cut.
########################################
