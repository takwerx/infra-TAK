module takwerx_console_confined 0.1;

########################################
# infra-TAK console — CONFINED domain (v10.0.5, SELinux hardening)
#
# Moves the non-root console OFF unconfined_service_t into a dedicated, confined
# `takwerx_console_t` domain. The console is a thin Flask/gunicorn app: it reads
# its install (/opt/infratak), reads/writes its config (.config), binds :5001,
# connects to the root broker's unix socket (/run/takwerx-broker.sock), spawns the
# brokerctl helper, and makes outbound HTTP. ALL genuinely-privileged work happens
# in the SEPARATE root broker process — so the console itself needs very little,
# which is exactly what makes confining it feasible.
#
# RAW module (checkmodule -M -m), so it builds with NO `make`/refpolicy-Makefile
# dependency — same mechanism start.sh already uses for takwerx_console.te.
#
# DEVELOPMENT POSTURE: ships `permissive takwerx_console_t` — the domain is ACTIVE
# (AVCs are logged against it) but does NOT block, so it can never brick the
# console. Allow-rules are grown from real AVCs (audit2allow) until a full deploy
# shows ZERO denials, then `permissive` is removed and the domain enforced.
########################################

require {
    type init_t;
    type user_home_t;
    type user_home_dir_t;
    type var_run_t;
    attribute domain;
    class process { transition dyntransition siginh rlimitinh noatsecure sigchld };
    class dir search;
    class file { entrypoint open read getattr execute execute_no_trans map ioctl };
    class lnk_file read;
    class sock_file write;
    class unix_stream_socket connectto;
}

type takwerx_console_t;
typeattribute takwerx_console_t domain;
role system_r types takwerx_console_t;

# Permissive WHILE WE HARVEST. Remove this single line to enforce (only after a
# full deploy shows zero AVCs against takwerx_console_t).
permissive takwerx_console_t;

# systemd (init_t) launches the console with SELinuxContext=...:takwerx_console_t
# (setexeccon -> transition). Allow the transition + inherited bits.
allow init_t takwerx_console_t:process { transition dyntransition siginh rlimitinh noatsecure };
allow takwerx_console_t init_t:process sigchld;

# Enter the domain via the venv entrypoint (covers the in-home + /opt/infratak
# install labels); init_t may traverse + read/exec it.
allow takwerx_console_t user_home_t:file entrypoint;
allow init_t user_home_dir_t:dir search;
allow init_t user_home_t:file { open read getattr execute execute_no_trans map ioctl };
allow init_t user_home_t:lnk_file read;

# Connect to the root broker's unix socket (the console's ONLY privilege path).
allow takwerx_console_t var_run_t:sock_file write;
allow takwerx_console_t init_t:unix_stream_socket connectto;

########################################
# HARVESTED (audit2allow) — appended during development; empty on first cut.
########################################
