{
  "name": "sensor-showcase",
  "title": "Sensor showcase: radar, ADS-B, AIS, UAS",
  "story": "A sweeping radar site at the center of the picture with three ADS-B-shaped aircraft on orbits and airways above it, two AIS-shaped vessels working a long channel, a helicopter in a holding orbit, a UAS with a sensor cone and video, four ground units on a patrol route, and periodic chat. Twenty minutes, looping; runs at 2x by default.",
  "version": 1,
  "duration_s": 1200,
  "loop": true,
  "default_tempo": 2,
  "defaults": {"interval_s": 3, "stale_s": 60, "team": "Cyan", "role": "Team Member", "lane": "1"},
  "entities": [
    {"id": "radar1", "callsign": "RADAR 1", "type": "a-f-G-E-S", "role": "HQ", "interval_s": 2,
     "path": {"kind": "static", "at": [0, 0]},
     "sensor": {"fov": 30, "range_m": 15000, "vfov": 20, "elevation": 5, "sweep_deg_s": 30},
     "remarks": "Simulated surveillance radar, 15 km, 30 deg beam sweeping 30 deg/s"},

    {"id": "n1", "callsign": "N123AB", "type": "a-n-A-C-F", "team": "White", "hae_m": 2500, "interval_s": 2,
     "path": {"kind": "orbit", "center": [4000, 3000], "radius_m": 3500, "speed_mps": 130, "clockwise": true},
     "remarks": "ADS-B: Cessna Citation, FL082"},
    {"id": "n2", "callsign": "N77QT", "type": "a-n-A-C-F", "team": "White", "hae_m": 3000, "interval_s": 2,
     "path": {"kind": "waypoints", "points": [[-14000, -9000], [-4000, -2000], [6000, 4000], [14000, 9000]], "speed_mps": 180, "loop": true},
     "remarks": "ADS-B: on the airway, FL098"},
    {"id": "n3", "callsign": "N908LF", "type": "a-n-A-C-F", "team": "White", "hae_m": 1500, "interval_s": 2,
     "path": {"kind": "waypoints", "points": [[12000, -8000], [3000, -3000], [-6000, 2000], [-12000, 7000]], "speed_mps": 120, "loop": true},
     "remarks": "ADS-B: light aircraft transiting, 5000 ft"},

    {"id": "mv1", "callsign": "MV NORTHERN STAR", "type": "a-n-S-X-M", "team": "White", "interval_s": 10, "stale_s": 120,
     "path": {"kind": "waypoints", "points": [[-15000, -6000], [-8000, -5500], [0, -5000], [8000, -4500], [15000, -4000]], "speed_mps": 6, "loop": true, "pause_s": 60},
     "remarks": "AIS: cargo, 11.7 kn"},
    {"id": "mv2", "callsign": "PILOT 4", "type": "a-n-S-X-M", "team": "White", "interval_s": 5, "stale_s": 120,
     "path": {"kind": "waypoints", "points": [[9000, -6500], [3000, -5200], [-3000, -6800], [-9000, -5400]], "speed_mps": 8, "loop": true},
     "remarks": "AIS: pilot boat, 15.5 kn"},

    {"id": "helo1", "callsign": "HELO 1", "type": "a-f-A-M-H", "team": "Yellow", "role": "Team Lead", "hae_m": 450, "interval_s": 2,
     "path": {"kind": "orbit", "center": [-3000, 2500], "radius_m": 900, "speed_mps": 45, "clockwise": false},
     "remarks": "Holding over the incident"},
    {"id": "uas1", "callsign": "UAS 1", "type": "a-f-A-M-H-Q", "team": "Yellow", "hae_m": 120, "interval_s": 2,
     "path": {"kind": "waypoints", "points": [[-1500, 800], [-500, 1400], [600, 900], [200, -300], [-900, -600]], "speed_mps": 14, "loop": true},
     "sensor": {"fov": 45, "range_m": 1500, "vfov": 30, "elevation": -25},
     "video": {"stream": "uas1"},
     "remarks": "Small UAS, EO/IR, streaming"},

    {"id": "g1", "callsign": "ALPHA 1", "type": "a-f-G-U-C", "team": "Cyan", "role": "Team Lead",
     "path": {"kind": "waypoints", "points": [[-2200, -400], [-1400, 300], [-600, -200], [200, 500], [900, -100], [200, -900], [-800, -1200]], "speed_mps": 1.6, "loop": true, "pause_s": 20}},
    {"id": "g2", "callsign": "ALPHA 2", "type": "a-f-G-U-C", "team": "Cyan",
     "path": {"kind": "waypoints", "points": [[-2300, -450], [-1500, 250], [-700, -250], [100, 450], [800, -150], [100, -950], [-900, -1250]], "speed_mps": 1.6, "loop": true, "pause_s": 20}},
    {"id": "g3", "callsign": "ALPHA 3", "type": "a-f-G-U-C", "team": "Cyan", "role": "Medic",
     "path": {"kind": "random_walk", "start": [1200, 1500], "radius_m": 350, "speed_mps": 1.2, "turn_deg_s": 40}},
    {"id": "g4", "callsign": "ALPHA 4", "type": "a-f-G-U-C", "team": "Cyan", "role": "RTO",
     "path": {"kind": "static", "at": [-400, 200]},
     "remarks": "Command post"}
  ],
  "events": [
    {"at_s": 0, "kind": "route", "id": "patrol", "callsign": "Patrol route", "color": "#00c8ff", "stale_s": 1300,
     "points": [[-2200, -400], [-1400, 300], [-600, -200], [200, 500], [900, -100], [200, -900], [-800, -1200]]},
    {"at_s": 0, "kind": "circle", "id": "radar-ring", "callsign": "RADAR 1 coverage 15 km", "at": [0, 0], "radius_m": 15000, "stroke": "#66ff66", "fill": "#66ff66", "fill_alpha": 20, "stale_s": 1300},
    {"at_s": 20, "kind": "chat", "from": "g1", "text": "ALPHA 1 starting patrol, radar picture is up"},
    {"at_s": 90, "kind": "chat", "from": "helo1", "text": "HELO 1 holding over the incident, UAS 1 has the objective on camera"},
    {"at_s": 200, "kind": "chat", "from": "g4", "text": "CP: three ADS-B contacts and two AIS tracks in the picture, all correlating"},
    {"at_s": 330, "kind": "chat", "from": "g3", "text": "ALPHA 3 checking the east side"},
    {"at_s": 480, "kind": "chat", "from": "g1", "text": "ALPHA 1 at checkpoint 4, continuing"},
    {"at_s": 640, "kind": "chat", "from": "helo1", "text": "HELO 1 fuel 60 percent, 25 minutes on station"},
    {"at_s": 800, "kind": "chat", "from": "g4", "text": "CP: MV NORTHERN STAR outbound, PILOT 4 returning to berth"},
    {"at_s": 960, "kind": "chat", "from": "g2", "text": "ALPHA 2 with ALPHA 1, nothing to report"},
    {"at_s": 1100, "kind": "chat", "from": "g4", "text": "CP: picture complete, looping the exercise"}
  ]
}
